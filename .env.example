# Copiar a .env y completar. NUNCA versionar el .env real.

# Clave secreta de Django: generar una propia para producción con
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SGE_SECRET_KEY=cambiar-esta-clave-en-produccion

# 1 en desarrollo, 0 en producción
SGE_DEBUG=1

# Hosts permitidos, separados por coma (ej: sge.escuela.edu.ar,localhost)
SGE_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. Vacío = SQLite local (desarrollo).
# Para PostgreSQL: postgres://usuario:clave@host:5432/nombre_base
SGE_DATABASE_URL=

# Zona horaria de la institución
SGE_TIME_ZONE=America/Argentina/San_Luis
